# Copy to `.env` and fill in locally. `.env` is gitignored and must never be committed.
# Nothing in this file may contain a real identifier — it is a tracked public file.

# ---------------------------------------------------------------------------
# Azure targeting
# ---------------------------------------------------------------------------
# Subscription the demo platform is provisioned into. Get it with:
#   az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Entra tenant. Get it with:
#   az account show --query tenantId -o tsv
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Ownership boundary
# ---------------------------------------------------------------------------
# The ONE resource group this project is allowed to create or mutate.
# Every other resource group in the subscription is read-only.
# Changing this value will fail `foundry boundary` unless config/boundary.yaml
# is updated to match, which is deliberate.
FOUNDRY_RESOURCE_GROUP=rg-contoso-agents

# Azure region chosen by `foundry regions`. Left blank on purpose: the region is
# an output of the selection tool, not an input. Do not hard-code a favourite.
FOUNDRY_LOCATION=

# Microsoft Entra security group whose members operate the isolated SRE Agent.
# Supply the group's object ID at deployment time; never commit a live value.
SRE_OPERATOR_GROUP_OBJECT_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Cost gate
# ---------------------------------------------------------------------------
# Hard ceiling on incremental Azure spend, in USD per month. CI fails above it.
FOUNDRY_MONTHLY_BUDGET_USD=500

# Currency used when querying the Azure Retail Prices API.
FOUNDRY_CURRENCY=USD
